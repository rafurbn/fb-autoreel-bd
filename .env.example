# ============================================================
# FB AutoReel BD — কনফিগারেশন
# এই ফাইলটি কপি করুন:  cp .env.example .env
# তারপর নিচের মানগুলো নিজের কী দিয়ে বসান। .env কখনো কমিট করবেন না।
# ============================================================

# ১) Google Gemini API কী (ফ্রি টিয়ার: https://aistudio.google.com/apikey)
#    দৈনিক রিকোয়েস্ট কোটা আছে; প্রতি রানে ১টি কল লাগে।
GEMINI_API_KEY=

# ২) ফেইসবুক পেজ — Meta Business Suite / Graph API Explorer থেকে
#    পেজ টোকেনে পেজের জন্য `pages_manage_posts` ও `publish_video` পারমিশন লাগবে।
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# ৩) ব্যাকগ্রাউন্ড ভিডিওর উৎস (গুরুত্বপূর্ণ: Pixabay নিলে Pexels ঐচ্ছিক)
#    Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
#    Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# ৪) ঐচ্ছিক — বাংলা ভয়েস (Edge-TTS)
#    বিকল্প: bn-BD-PradeepNeural (পুরুষ) | bn-BD-NabanitaNeural (নারী)
TTS_VOICE=bn-BD-PradeepNeural

# ৫) ঐচ্ছিক — ভিডিওতে দেখানো ব্র্যান্ডের নাম
BRAND_NAME=হাসির মেলা BD
